<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="ie=edge" />
    <title>megan renae</title>
    <link rel="stylesheet" href="{{ paths.css }}" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <script src="https://kit.fontawesome.com/1df0fd71fd.js" crossorigin="anonymous"></script>
  </head>
  <body>
    <div id="container">
      <div id="terminal">
        <div id="top-bar">MROS</div>
        <p class="term-log term-log-old">user@meganrenae.me:~$ <span class="entry"></span>
        <h1 class="title">megan_renae</h1>
        <p class="subtitle">version {{ pkg.version }}</p>
        {% include 'navmenu.njk' %}
        {{ content | safe }}
        {% if comments_url %}
          {% modalBtn "comments-modal", "Comments" %}
          {% comments %}
            {{ comments_url }}
          {% endcomments %}
        {% endif %}
        {% include 'social.njk' %}
        {% include 'coffee.njk' %}
        {% include 'license.njk' %}
        <p class="term-log prompt-log">user@meganrenae.me:~{{ page.url }}$ <span class="entry" id="prompt-entry"> </span></p>
      </div> 
    </div>
    <script src={{ paths.js }} type="module"></script>
  </body>
</html>
